# Copy to .env and fill in. Never commit .env.
QBT_URL=http://192.168.1.100:8080

# Authentication: use EITHER username + password OR an API key (qBittorrent 5.2.0+), never both.
# Option 1: username + password
QBT_USERNAME=
QBT_PASSWORD=
# Option 2: API key (then leave QBT_USERNAME and QBT_PASSWORD empty)
#QBT_API_KEY=qbt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Values shown are the built-in defaults; see README for details.
#SLOWBAN_MIN_SPEED=100000
#SLOWBAN_WARN_TIME=90
#SLOWBAN_THRESHOLD_TIME=180
#SLOWBAN_POLL_INTERVAL=10
#SLOWBAN_SUMMARY_INTERVAL=600
#SLOWBAN_CLEAR_PERIODICALLY=
#SLOWBAN_BANNED_PEERS=
#SLOWBAN_LOG_LEVEL=INFO
#SLOWBAN_LOG_RETENTION_DAYS=7
#SLOWBAN_LOG_UNBAN_DETAILS=false
#SLOWBAN_COLOR_LOGS=true
#SLOWBAN_DRY_RUN=false
